					<Size x="215" y="32" />
					<Anchors><Anchor point="LEFT" x="37" /></Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button parentKey="Key1" inherits="UIMenuButtonStretchTemplate">
				<Size x="160" y="22" />
				<Anchors><Anchor point="LEFT" x="238" /></Anchors>
			</Button>
			<Button parentKey="Key2" inherits="UIMenuButtonStretchTemplate">
				<Size x="160" y="22" />
				<Anchors><Anchor point="LEFT" x="398" /></Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad" />
			<OnHide method="OnHide" />
		</Scripts>
	</Frame>

	<Frame name="ProfessionShoppingList_SettingsExpandTemplate" inherits="SettingsExpandableSectionTemplate" mixin="ProfessionShoppingList_SettingsExpandMixin" virtual="true">
		<Size y="24" />
	</Frame>

	<Frame name="ProfessionShoppingList_Tab" virtual="true" inherits="QuestLogTabButtonTemplate">
		<KeyValues>
			<KeyValue key="displayMode" value="QuestLogDisplayMode.Quests" type="global" />
			<KeyValue key="tooltipText" value="|cff3FC7EBProfession Shopping List" type="string" />
